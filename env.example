*{box-sizing:border-box}body{margin:0;background:#07090d;color:#f4f7fb;font-family:Arial,Tahoma,sans-serif;min-height:100vh;background-image:radial-gradient(circle at 70% 20%,rgba(50,255,130,.08),transparent 30%),linear-gradient(135deg,#07090d,#0b1013)}nav{height:78px;border-bottom:1px solid #1b2720;display:flex;align-items:center;justify-content:space-between;padding:0 7%;background:rgba(7,9,13,.8)}.brand{font-weight:900;letter-spacing:1px}.brand span{color:#3cff83;margin-right:8px}.landing{display:grid;place-items:center;min-height:calc(100vh - 78px);padding:30px}.hero{max-width:850px;text-align:center;padding:70px 30px}.hero.small{text-align:right;max-width:none;padding:35px 0}.badge{display:inline-block;border:1px solid #285d3b;background:#0d2115;color:#54ff91;border-radius:999px;padding:8px 15px;font-size:14px}.hero h1{font-size:clamp(38px,7vw,78px);line-height:1.08;margin:25px 0}.hero.small h1{font-size:42px}.hero em{font-style:normal;color:#3cff83}.hero p{color:#a8b3ad;font-size:18px;line-height:1.8;max-width:680px;margin:0 auto 30px}.hero.small p{margin:0}.discord-btn,.logout{display:inline-block;text-decoration:none;color:white;background:#5865f2;padding:15px 25px;border-radius:12px;font-weight:800}.status{margin-top:28px;color:#8d9b93}.status i{display:inline-block;width:9px;height:9px;border-radius:50%;background:#3cff83;margin-left:8px}.dashboard{max-width:1150px;margin:auto;padding:35px 25px}.user{display:flex;align-items:center;gap:12px}.user img{width:42px;height:42px;border-radius:50%}.logout{padding:9px 13px;background:#171d21;font-size:13px}.servers{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px}.server-card,.empty{border:1px solid #1e2b24;background:#0d1210;border-radius:16px;padding:18px;display:flex;align-items:center;gap:14px}.server-icon{width:54px;height:54px;border-radius:15px;background:#193522;display:grid;place-items:center;color:#4cff8d;font-size:24px;font-weight:900}.server-card h3{margin:0 0 7px}.server-card p{margin:0;color:#89968f;font-size:14px}.server-card button{margin-right:auto;background:#15201a;border:1px solid #284332;color:#718078;padding:9px 12px;border-radius:9px}@media(max-width:650px){nav{padding:0 4%}.brand span{display:none}.user strong{display:none}.hero{padding:35px 10px}.hero h1{font-size:42px}}